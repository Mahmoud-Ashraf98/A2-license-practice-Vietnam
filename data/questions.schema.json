{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vn-motorcycle:question-bank:1.0.0",
  "title": "Vietnam motorcycle 250-question handoff bank",
  "type": "object",
  "required": ["schema_version", "bank_id", "valid_from", "valid_through", "source_registry", "questions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bank_id": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date"},
    "valid_through": {"type": "string", "format": "date"},
    "source_registry": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "title", "url"]}},
    "questions": {"type": "array", "minItems": 250, "maxItems": 250, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["vi", "en"],
      "properties": {"vi": {"type": "string", "minLength": 1}, "en": {"type": ["string", "null"]}}
    },
    "option": {
      "type": "object",
      "required": ["id", "number", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^q[0-9]{3}_opt_[1-4]$"},
        "number": {"type": "integer", "minimum": 1, "maximum": 4},
        "text": {"$ref": "#/$defs/localized"}
      }
    },
    "image": {
      "type": "object",
      "required": ["path", "width", "height", "sha256", "figure_label", "alt_vi", "alt_en", "source"],
      "properties": {
        "path": {"type": "string", "pattern": "^assets/questions/q[0-9]{3}(-[12])?\\.png$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "figure_label": {"type": ["string", "null"]},
        "alt_vi": {"type": "string"},
        "alt_en": {"type": "string"},
        "source": {
          "type": "object",
          "required": ["document_id", "pdf_page_1_based", "pdf_image_xref", "pdf_bbox_points", "method"],
          "properties": {
            "document_id": {"type": "string"},
            "pdf_page_1_based": {"type": "integer", "minimum": 1},
            "pdf_image_xref": {"type": "integer", "minimum": 1},
            "pdf_bbox_points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "official_id", "motorcycle_ordinal", "chapter", "topic", "question", "options", "correct_option_id", "correct_option_number", "critical_for_motorcycle", "critical_for_car", "requires_image", "image_layout", "images", "phrase_ids", "source", "translation_status", "explanation", "option_order_policy", "canonical_content_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^q[0-9]{3}$"},
        "official_id": {"type": "integer", "minimum": 1, "maximum": 600},
        "motorcycle_ordinal": {"type": "integer", "minimum": 1, "maximum": 250},
        "chapter": {"enum": [1, 2, 3, 5, 6]},
        "topic": {"type": "string"},
        "question": {"$ref": "#/$defs/localized"},
        "options": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/option"}},
        "correct_option_id": {"type": "string", "pattern": "^q[0-9]{3}_opt_[1-4]$"},
        "correct_option_number": {"type": "integer", "minimum": 1, "maximum": 4},
        "critical_for_motorcycle": {"type": "boolean"},
        "critical_for_car": {"type": "boolean"},
        "requires_image": {"type": "boolean"},
        "image_layout": {"enum": ["block", "labelled_row"]},
        "images": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/image"}},
        "phrase_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "source": {"type": "object", "required": ["document_id", "pdf_path", "pdf_pages_1_based", "official_question_id", "answer_key_verification", "verified_date"]},
        "translation_status": {"type": "object", "required": ["question_en", "options_en", "official_translation"]},
        "explanation": {"type": "object", "required": ["vi", "en", "status"]},
        "option_order_policy": {"const": "preserve_original"},
        "canonical_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
